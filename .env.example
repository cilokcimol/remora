# Copy to .env.local and fill in (never commit real values)
# Z.AI API key (https://z.ai/manage-apikey/apikey-list)
ZAI_API_KEY=

# Mistral API key (Mistral console) - enables the automatic fallback when Z.AI saturates
MISTRAL_API_KEY=

# Walrus Memory credentials (https://memory.walrus.xyz dashboard)
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
